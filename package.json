{
  "name": "pandofy",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "main": "electron-main.js",
  "description": "Pandofy - Plateforme de streaming musical communautaire",
  "author": "Pandofy Team",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "music-metadata": "^11.12.3",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "wavesurfer.js": "^7.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.pandofy.app",
    "productName": "Pandofy",
    "publish": {
      "provider": "github",
      "owner": "zyko144",
      "repo": "pandofy"
    },
    "files": [
      "dist/**/*",
      "server.js",
      "server/**/*",
      "uploads/**/*",
      "electron-main.js",
      "electron-preload.cjs",
      "public/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pandofy"
    }
  }
}